{
  "name": "resi-printer",
  "version": "1.0.0",
  "description": "Print Shopee Xpress (SPX) resi labels on ESC/POS thermal printers over Bluetooth Low Energy",
  "type": "module",
  "bin": {
    "resi": "./bin/resi.mjs"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "scan": "bun bin/resi.mjs scan",
    "probe": "bun bin/resi.mjs probe",
    "features": "bun bin/resi.mjs features",
    "preview": "bun bin/resi.mjs preview --file assets/resi.pdf",
    "print": "bun bin/resi.mjs print",
    "web": "bun bin/resi.mjs web",
    "selftest": "bun bin/resi.mjs selftest",
    "test": "bun test",
    "import": "bun bin/resi.mjs import"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  },
  "license": "MIT",
  "private": true
}
